{
  "dependencies": {
    "mgplus": "^1.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "esbuild ./frontend/src/index.jsx --bundle --outdir=./frontend/out",
    "start": "npm install && npm run setup && npm run build && ./.venv/bin/python backend/main.py"
  },
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
